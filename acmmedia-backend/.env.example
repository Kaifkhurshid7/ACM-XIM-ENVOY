# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB connection string (MongoDB Atlas recommended for production)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/acmmedia

# ─── Authentication ───────────────────────────────────────────────────────────
# Secret key for signing JWT tokens. REQUIRED — the server fails fast if unset.
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here

# No longer used — admin accounts are provisioned via the admin-only
# POST /api/v1/auth/create-admin endpoint.

# ─── External APIs ───────────────────────────────────────────────────────────
# NewsAPI key for fetching technology news (https://newsapi.org)
NEWS_API_KEY=your_newsapi_key_here

# ─── Server ──────────────────────────────────────────────────────────────────
# Port for the Express server (defaults to 5000)
PORT=5000

# Node environment (development | production)
NODE_ENV=development

# ─── Email Service ───────────────────────────────────────────────────────────
# SMTP configuration for transactional emails (verification, password reset, alerts)
# Recommended: Gmail, SendGrid, Mailgun, or AWS SES
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
FROM_EMAIL=noreply@acmmedia.com

# ─── Logging ─────────────────────────────────────────────────────────────────
# Log level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
